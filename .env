# ============================================================
# MCoin Discord Bot - Environment Configuration
# ============================================================

# --- Discord Bot (discord.js / Node.js) ---
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
# Guild ID สำหรับ dev (deploy instant) - ลบออกสำหรับ global commands
DISCORD_GUILD_ID=your_guild_id_here

# --- MySQL / MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=mcoin_user
DB_PASSWORD=your_db_password_here
DB_NAME=mcoin

# --- Fiat Exchange Rate API ---
# https://app.exchangerate-api.com (free plan: 1,500 req/month)
EXCHANGE_RATE_API_KEY=5243b75340c4b7c8bb8b1c36
# Cache duration in ms (default 1 hour)
RATE_CACHE_TTL_MS=3600000

# --- Gold/Silver Spot Price API (goldapi.io) ---
# https://www.goldapi.io (free plan: 100 req/day)
# Used for XAU (gold) and XAG (silver) spot prices
XAU_API_KEY=b4ffcbb91805801153573b3337945472
# Metals cache TTL in ms (default 30 min - separate from fiat)
METALS_CACHE_TTL_MS=1800000

# --- Default MBC Rate ---
MBC_INITIAL_RATE_USD=1.00

# --- Staking ---
# Default APR as decimal (0.12 = 12% per year)
STAKING_DEFAULT_APR=0.12

# --- Admin API ---
ADMIN_API_KEY=change_this_to_a_strong_random_secret
API_PORT=3001

# --- External Wallet API ---
WALLET_API_KEY=change_this_to_a_strong_random_secret

# --- Escrow ---
# Timeout in ms (default 5 minutes)
ESCROW_TIMEOUT_MS=300000
